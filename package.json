{
  "name": "advisory-board",
  "version": "1.0.0",
  "description": "A website highlighting current and past members of the school of TAD\u2019s advisory board.",
  "main": "header-fit.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs tests/ui.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tad-advisory \"node --test tests/rules.test.mjs\"",
    "serve": "python -m http.server 4173",
    "build:hosting": "npm run build && node scripts/prepare-hosting.mjs",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting --project tad-advisory-board",
    "test:migration": "node --test tests/migration.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BSUTAD/Advisory-Board.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/BSUTAD/Advisory-Board/issues"
  },
  "homepage": "https://github.com/BSUTAD/Advisory-Board#readme",
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase-tools": "^14.22.0",
    "happy-dom": "^20.14.5"
  },
  "private": true
}
